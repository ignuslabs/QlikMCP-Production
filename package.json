{
  "name": "qlik-ai-harness-bedrock-agentcore",
  "version": "0.4.1-rc.1",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.8",
  "description": "Amazon Bedrock AgentCore Runtime edition of the governed MCP harness for planning, previewing, approving, and persisting native Qlik visualizations.",
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10.9.8 <11"
  },
  "bin": {
    "qlik-ai-harness": "dist/index.js",
    "qlik-ai-harness-agentcore": "dist/agentcore/runtime.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "src/**/*.ts",
    "config/README.md",
    "config/*.example.json",
    "config/alerts/*.yaml",
    "docs/*.md",
    "docs/deployment/*.md",
    "docs/runbooks/*.md",
    "infra/aws/*.yaml",
    "infra/aws/*.parameters.example.json",
    "scripts/**/*.mjs",
    "scripts/browser/*.ts",
    "scripts/browser/*.js",
    "scripts/codex/*.sh",
    "test/**/*.ts",
    "test/fixtures/**/*.json",
    "test/fixtures/README.md",
    "examples/qlik-embed/README.md",
    "examples/qlik-embed/*.html",
    "examples/qlik-embed/*.js",
    "examples/providers/**/*.example.json",
    "examples/providers/**/*.example.yaml",
    ".env.example",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "Dockerfile",
    ".dockerignore",
    ".nvmrc",
    ".npmrc",
    "tsconfig.json",
    "tsconfig.build.json",
    "vitest.config.ts",
    "eslint.config.js",
    ".prettierrc.json"
  ],
  "scripts": {
    "build": "node scripts/package/cleanDist.mjs && tsc -p tsconfig.build.json && node scripts/package/preparePackage.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:live:cloud": "node scripts/mcp/run-node.mjs -- node_modules/tsx/dist/cli.mjs test/live/cloudAdapterProbe.ts",
    "test:live:management": "node scripts/mcp/run-node.mjs -- node_modules/tsx/dist/cli.mjs test/live/managementAcceptance.ts",
    "dataset:transfer": "node scripts/mcp/run-node.mjs -- scripts/mcp/uploadDataset.mjs",
    "test:live:cloud:retain": "node scripts/mcp/run-node.mjs -- node_modules/tsx/dist/cli.mjs test/live/cloudRetainedObjectProbe.ts",
    "test:live:cloud:matrix": "node scripts/mcp/run-node.mjs -- node_modules/tsx/dist/cli.mjs test/live/cloudVisualizationMatrix.live.ts",
    "test:live:cloud:matrix:retain": "node scripts/mcp/run-node.mjs --env QLIK_CLOUD_MATRIX_ACTION=retain -- node_modules/tsx/dist/cli.mjs test/live/cloudVisualizationMatrix.live.ts",
    "test:live:cloud:matrix:cleanup": "node scripts/mcp/run-node.mjs --env QLIK_CLOUD_MATRIX_ACTION=cleanup -- node_modules/tsx/dist/cli.mjs test/live/cloudVisualizationMatrix.live.ts",
    "test:live:cloud:matrix:reconcile": "node scripts/mcp/run-node.mjs --env QLIK_CLOUD_MATRIX_ACTION=reconcile -- node_modules/tsx/dist/cli.mjs test/live/cloudVisualizationMatrix.live.ts",
    "browser:prepare": "tsx scripts/browser/generateQlikEmbedLocal.ts",
    "browser:serve": "tsx scripts/browser/serveQlikEmbedLocal.ts",
    "test:live:windows": "tsx test/live/windowsG6.live.ts",
    "docs:check": "node scripts/package/checkMarkdownLinks.mjs",
    "package:check": "npm run build && node scripts/package/verifyPackage.mjs",
    "security:check": "node scripts/package/checkRepositoryHygiene.mjs",
    "shell:check": "node scripts/package/checkShellScripts.mjs",
    "check": "npm run typecheck && npm run lint && npm run docs:check && npm run security:check && npm run package:check && npm run shell:check && npm run test",
    "release:check": "npm run check && npm audit --registry=https://registry.npmjs.org/",
    "demo:fixture": "vitest run test/integration/e2eWorkflow.test.ts --reporter=verbose",
    "prepack": "npm run build && npm run docs:check && npm run security:check",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/agentcore/runtime.js",
    "dev:agentcore": "QLIK_AGENTCORE_LOCAL_DEV=true tsx watch src/agentcore/runtime.ts",
    "agentcore:config": "node scripts/agentcore/render-config.mjs",
    "agentcore:validate": "agentcore validate",
    "agentcore:dev": "agentcore dev",
    "agentcore:deploy:diff": "agentcore deploy --diff",
    "agentcore:deploy": "agentcore deploy",
    "agentcore:status": "agentcore status",
    "agentcore:require-mmdsv2": "node scripts/agentcore/require-mmdsv2.mjs",
    "mcp:start": "node scripts/mcp/start.mjs",
    "mcp:doctor": "node scripts/mcp/doctor.mjs",
    "mcp:config": "node scripts/mcp/doctor.mjs --print-vscode-config",
    "container:smoke": "node scripts/ci/smoke-container.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore-control": "3.1132.0",
    "@aws-sdk/client-dynamodb": "3.1132.0",
    "@aws-sdk/client-secrets-manager": "3.1132.0",
    "@aws-sdk/lib-dynamodb": "3.1132.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@qlik/api": "2.15.2",
    "dotenv": "16.4.7",
    "read-excel-file": "9.3.10",
    "saxen": "11.1.0",
    "zod": "4.4.3",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
