# Qlik AI Harness for Amazon Bedrock AgentCore
# Safe local fixture template only. Copy to .env; never commit .env.

# Local AgentCore-compatible server. Deployed config never sets LOCAL_DEV.
QLIK_AGENTCORE_LOCAL_DEV=true
QLIK_AGENTCORE_LOCAL_HOST=127.0.0.1
QLIK_AGENTCORE_LOCAL_ACTOR=local-agentcore-actor
QLIK_AGENTCORE_REQUEST_TIMEOUT_MS=30000
QLIK_AGENTCORE_REQUESTS_PER_MINUTE=60
PORT=8000

# Offline deterministic adapter. The deployed generator sets cloud explicitly.
QLIK_HARNESS_TARGET_MODE=fixture
QLIK_HARNESS_MCP_ROLE=all
QLIK_HARNESS_LOG_LEVEL=info
QLIK_HARNESS_MUTATION_ACTORS=
QLIK_HARNESS_REVIEWER_ACTORS=
QLIK_HARNESS_CONFIG_DIR=./config
QLIK_HARNESS_FIXTURES_DIR=./test/fixtures
QLIK_HARNESS_CONNECTIONS_JSON=

# Optional app/sheet/dataset management is disabled when both are blank.
# AgentCore Cloud runtime only; an enabled policy also requires Cloud credentials.
# Choose exactly one source. Local policy shape: config/management.example.json.
# Copy to ignored config/management.json and review exact identities/actions/scopes.
# The deployment renderer emits policy JSON from its managementPolicy object.
QLIK_MANAGEMENT_POLICY_PATH=
QLIK_MANAGEMENT_POLICY_JSON=

# Optional default endpoint for npm run dataset:transfer. It only stages/uploads
# private chunks; writing the sealed dataset to Qlik requires an approved workflow.
QLIK_MANAGEMENT_MCP_URL=
# Inject QLIK_MANAGEMENT_BEARER_TOKEN through the approved credential mechanism;
# never save the actual token in this template, tracked files, or shell history.
# Dataset limit: 50 MiB; private export limit: 200 MiB; policy may lower either.
# See docs/management.md for profiles, one-day artifact expiry, and recovery.

# Legacy local STDIO actor labels; deployed AgentCore derives these from JWT.
QLIK_HARNESS_ACTOR=local-dev-actor
QLIK_HARNESS_HOST_CLIENT_ID=local-mcp-host

# Deployed AgentCore values are generated from the non-secret deployment file.
# Leave blank for the local fixture.
QLIK_AGENTCORE_STATE_TABLE=
QLIK_AGENTCORE_QLIK_SECRET_ID=
QLIK_AGENTCORE_JWT_DISCOVERY_URL=
QLIK_AGENTCORE_JWT_AUDIENCE=
QLIK_AGENTCORE_JWT_ALLOWED_CLIENT_IDS=
QLIK_AGENTCORE_JWT_REQUIRED_SCOPES=

# Qlik Cloud non-secret routing example. The local fixture never contacts it.
QLIK_CLOUD_CONNECTION_ALIAS=cloud-dev
QLIK_CLOUD_TENANT_HOST=https://qlik-cloud-demo.example
QLIK_CLOUD_TENANT_ALIAS=cloud-demo-tenant
QLIK_CLOUD_REGION_ALIAS=demo-region
QLIK_CLOUD_ENVIRONMENT=development
QLIK_CLOUD_OAUTH_CLIENT_ID=00000000-0000-4000-8000-000000000201

# Local Cloud development only. AgentCore deployment must keep this absent and
# retrieve the JSON secret through QLIK_AGENTCORE_QLIK_SECRET_ID.
QLIK_CLOUD_OAUTH_CLIENT_SECRET=

QLIK_CLOUD_WRITE_APP_ID=app-sales-cloud-dev
QLIK_CLOUD_WRITE_SHEET_ID=sheet-sales-overview-cloud-dev
QLIK_CLOUD_READINESS_APPROVED=false
QLIK_CLOUD_READINESS_EXPIRES_AT=1970-01-01T00:00:00.000Z
QLIK_CLOUD_READINESS_CAN_READ=false
QLIK_CLOUD_READINESS_CAN_PREVIEW=false
QLIK_CLOUD_READINESS_CAN_WRITE_DESIGNATED_SHEET=false
QLIK_CLOUD_READINESS_CLEANUP_VERIFIED=false

# Explicit live Cloud probes are excluded from npm run check.
QLIK_CLOUD_LIVE_PROBE=
QLIK_CLOUD_PROBE_DIMENSION=Region
QLIK_CLOUD_PROBE_MEASURE=Revenue
QLIK_CLOUD_PROBE_ACTOR=local-dev-actor
QLIK_CLOUD_PROBE_REVIEWER=local-dev-reviewer

# The core still contains its tested Windows adapter, but the AgentCore runtime
# refuses Windows mode until private routing and certificate/proxy secrets have
# a separate reviewed implementation.
QLIK_WINDOWS_CONNECTION_ALIAS=windows-dev
QLIK_WINDOWS_SERVER_ALIAS=https://sense-dev.example.invalid
QLIK_WINDOWS_VIRTUAL_PROXY_ALIAS=demo-proxy
QLIK_WINDOWS_AUTH_MODE=proxy-session
QLIK_WINDOWS_DISCOVERY_APP_ID=app-sales-windows-dev
QLIK_WINDOWS_WRITE_APP_ID=app-sales-windows-dev
QLIK_WINDOWS_WRITE_SHEET_ID=sheet-sales-overview-windows-dev
QLIK_WINDOWS_READINESS_APPROVED=false
QLIK_WINDOWS_READINESS_EXPIRES_AT=1970-01-01T00:00:00.000Z
QLIK_WINDOWS_READINESS_CAN_READ=false
QLIK_WINDOWS_READINESS_CAN_PREVIEW=false
QLIK_WINDOWS_READINESS_CAN_WRITE_DESIGNATED_SHEET=false
QLIK_WINDOWS_READINESS_CLEANUP_VERIFIED=false
QLIK_WINDOWS_PROXY_SESSION_JWT=
QLIK_WINDOWS_TRUSTED_BACKEND_PFX_BASE64=
QLIK_WINDOWS_TRUSTED_BACKEND_PFX_PASSPHRASE=
QLIK_WINDOWS_TRUSTED_BACKEND_USER_HEADER=
