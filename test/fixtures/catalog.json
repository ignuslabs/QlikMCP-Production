      "sheets": [
        {
          "id": "sheet-sales-overview-windows-dev",
          "alias": "sales-overview-windows-dev",
          "name": "Sales Overview",
          "writeAllowed": true
        },
        {
          "id": "sheet-sales-readonly-windows-dev",
