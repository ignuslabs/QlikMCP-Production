          "stage": "apply"
        },
        "previewMaySucceed": true,
        "mutationAttempted": true,
        "persistentObjectCreated": false,
        "cleanupRequired": false
      }
    },
    {
      "id": "planner-negative-cases",
      "description": "The planner rejects invalid references, chart types, expressions, and role combinations without mutation.",
      "targets": [
        "cloud-dev",
        "windows-dev"
      ],
      "cases": [
        {
          "id": "unknown-field",
          "request": {
            "dimensions": [
              "NotInCatalog"
            ],
            "measures": [
              "Revenue"
            ],
            "preferredChartType": "barchart"
          },
          "expectedFailure": {
            "code": "UNKNOWN_FIELD",
            "category": "validation",
            "retryable": false,
            "stage": "planning"
          }
        },
        {
          "id": "unsupported-chart",
          "request": {
            "dimensions": [
              "Region"
            ],
            "measures": [
              "Revenue"
            ],
            "preferredChartType": "radar"
          },
          "expectedFailure": {
            "code": "UNSUPPORTED_CHART",
            "category": "validation",
            "retryable": false,
            "stage": "planning"
          }
        },
        {
          "id": "disallowed-expression",
          "request": {
            "dimensions": [
              "Region"
            ],
            "measures": [
              "Sum(Revenue)+Avg(Margin)"
            ],
            "preferredChartType": "barchart"
          },
          "expectedFailure": {
            "code": "DISALLOWED_EXPRESSION",
            "category": "policy",
            "retryable": false,
            "stage": "planning"
          }
        },
        {
          "id": "invalid-dimension",
          "request": {
            "dimensions": [
              "Revenue"
            ],
            "measures": [
              "Margin"
            ],
            "preferredChartType": "barchart"
          },
          "expectedFailure": {
            "code": "INVALID_DIMENSION",
            "category": "validation",
            "retryable": false,
            "stage": "planning"
          }
        },
        {
          "id": "invalid-measure",
          "request": {
            "dimensions": [
              "Region"
            ],
            "measures": [
              "OrderDate"
            ],
            "preferredChartType": "barchart"
          },
          "expectedFailure": {
            "code": "INVALID_MEASURE",
            "category": "validation",
            "retryable": false,
            "stage": "planning"
          }
        }
      ],
      "expected": {
        "status": "failed",
        "mutationAttempted": false,
        "cleanupRequired": false
      }
    },
    {
      "id": "capacity-transient-rate-limit",
      "description": "Provider failures use the same typed contract on Cloud and Windows.",
      "targets": [
        "cloud-dev",
        "windows-dev"
      ],
      "cases": [
        {
          "id": "capacity",
          "expectedFailure": {
            "code": "CAPACITY_EXHAUSTED",
            "category": "capacity",
            "retryable": true,
            "stage": "preview",
            "retryAfterSeconds": 30
          },
          "retryPolicy": "bounded-backoff"
        },
        {
          "id": "transient",
          "expectedFailure": {
            "code": "TRANSIENT_UNAVAILABLE",
            "category": "transient",
            "retryable": true,
            "stage": "preview",
            "retryAfterSeconds": 5
          },
          "retryPolicy": "bounded-backoff"
        },
        {
          "id": "rate-limit",
          "expectedFailure": {
            "code": "RATE_LIMITED",
            "category": "rate-limit",
            "retryable": true,
            "stage": "discovery",
            "retryAfterSeconds": 15
          },
          "retryPolicy": "bounded-backoff"
        }
      ],
      "cleanupExpectation": {
        "required": true,
        "scope": "any-open-session-or-session-object",
        "expectedResult": "close/dispose is attempted before a retry or final failure"
      }
    },
    {
      "id": "approval-expiry",
      "description": "An expired approval cannot authorize a later apply.",
      "targets": [
        "cloud-dev",
        "windows-dev"
      ],
      "request": {
        "planHash": "sha256:fixture-normal-sales-by-region-v1",
        "approvalState": "expired",
        "expiresAt": "2026-01-01T00:00:00Z"
      },
      "expected": {
        "status": "failed",
        "typedFailure": {
          "code": "APPROVAL_EXPIRED",
          "category": "approval",
          "retryable": false,
          "stage": "apply"
        },
        "adapterMutationInvoked": false,
        "cleanupRequired": false
      }
    },
    {
      "id": "approval-replay",
