      },
      "expected": {
        "status": "failed",
        "typedFailure": {
          "code": "APPROVAL_REPLAYED",
          "category": "approval",
          "retryable": false,
          "stage": "apply"
        },
        "adapterMutationInvoked": false,
        "cleanupRequired": false
      }
    },
    {
      "id": "idempotent-completed-replay",
      "description": "A completed operation replay returns the original sanitized result without another mutation.",
      "targets": [
        "cloud-dev",
        "windows-dev"
      ],
      "request": {
        "actor": "fixture-analyst",
        "connectionAlias": "cloud-dev",
        "appId": "app-sales-cloud-dev",
        "sheetId": "sheet-sales-overview-cloud-dev",
        "planHash": "sha256:fixture-normal-sales-by-region-v1",
        "idempotencyKey": "fixture-idempotency-normal-001"
      },
      "expected": {
        "status": "replayed",
        "originalOperationId": "operation-normal-cloud-001",
        "originalObjectId": "object-normal-cloud-001",
        "sameSanitizedResult": true,
        "adapterMutationInvoked": false,
        "cleanupRequired": false
      }
    },
    {
      "id": "conflicting-idempotency-key",
      "description": "Reusing a completed idempotency key for a different plan is rejected.",
      "targets": [
        "cloud-dev",
        "windows-dev"
