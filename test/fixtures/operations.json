  "scenarios": [
    {
      "id": "normal-workflow",
      "description": "The same approved native chart workflow is valid for both target adapters.",
      "targets": [
        "cloud-dev",
        "windows-dev"
      ],
      "request": {
        "appAliasByTarget": {
          "cloud-dev": "sales-app-cloud-dev",
          "windows-dev": "sales-app-windows-dev"
        },
        "sheetAliasByTarget": {
          "cloud-dev": "sales-overview-cloud-dev",
          "windows-dev": "sales-overview-windows-dev"
        },
        "dimensions": [
          "Region"
        ],
        "measures": [
          "Revenue"
        ],
        "preferredChartType": "barchart",
        "mode": "preview-then-apply"
      },
      "expected": {
        "workflow": [
          "discovered",
          "planned",
          "previewed",
          "approval-requested",
          "approved",
          "applying",
          "verified"
        ],
        "status": "verified",
        "planHash": "sha256:fixture-normal-sales-by-region-v1",
        "rendering": "qlik-embed",
        "objectIdByTarget": {
          "cloud-dev": "object-normal-cloud-001",
          "windows-dev": "object-normal-windows-001"
        },
        "cleanupExpectation": {
          "required": true,
          "scope": "created-object-and-created-sheet-attachment",
          "mustNotDelete": "pre-existing objects",
          "expectedResult": "test object and attachment are removed by the cleanup runbook"
        }
      }
    },
    {
      "id": "empty-catalog",
      "description": "Discovery returns a valid empty catalog without exposing hidden metadata.",
      "targets": [
        "cloud-dev",
        "windows-dev"
      ],
      "request": {
        "catalogVariant": "empty",
        "appAliasByTarget": {
          "cloud-dev": "sales-app-cloud-dev",
          "windows-dev": "sales-app-windows-dev"
        }
      },
      "expected": {
        "status": "failed",
        "typedFailure": {
          "code": "EMPTY_CATALOG",
          "category": "catalog",
          "retryable": false,
          "stage": "discovery"
        },
        "mutationAttempted": false,
        "cleanupRequired": false
      }
    },
    {
      "id": "high-cardinality-bounded-result",
      "description": "A high-cardinality dimension is allowed only with a bounded result.",
      "targets": [
        "cloud-dev",
        "windows-dev"
      ],
      "request": {
        "dimensions": [
          "CustomerID"
        ],
        "measures": [
          "Revenue"
        ],
        "preferredChartType": "table",
        "resultLimit": 10
      },
      "expected": {
        "status": "previewed",
        "dimensionCardinalityBand": "high",
        "returnedRows": 10,
        "maxRows": 10,
        "truncated": true,
        "continuation": "fixture-continuation-001",
        "rawDataIncluded": false,
        "cleanupRequired": true,
        "cleanupExpectation": {
          "scope": "session-preview-only",
          "expectedResult": "session object is disposed after preview"
        }
      }
    },
    {
      "id": "not-found",
