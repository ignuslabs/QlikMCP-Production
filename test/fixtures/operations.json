      "expected": {
        "status": "failed",
        "typedFailure": {
          "code": "IDEMPOTENCY_CONFLICT",
          "category": "idempotency",
          "retryable": false,
          "stage": "apply"
        },
        "adapterMutationInvoked": false,
        "cleanupRequired": false
      }
    },
    {
      "id": "approval-binding-mismatches",
      "description": "An approval cannot be applied by another actor, to another target, or for another plan.",
      "targets": [
        "cloud-dev",
        "windows-dev"
      ],
      "cases": [
        {
          "id": "actor-mismatch",
          "request": {
            "approvalActor": "fixture-approver",
            "applyingActor": "fixture-other-actor",
            "planHash": "sha256:fixture-normal-sales-by-region-v1"
          },
          "expectedFailure": {
            "code": "APPROVAL_ACTOR_MISMATCH",
            "category": "approval",
            "retryable": false,
            "stage": "apply"
          }
        },
        {
          "id": "target-mismatch",
          "request": {
            "approvalTarget": "cloud-dev/app-sales-cloud-dev/sheet-sales-overview-cloud-dev",
            "applyingTarget": "cloud-dev/app-sales-cloud-dev/sheet-sales-readonly-cloud-dev",
            "planHash": "sha256:fixture-normal-sales-by-region-v1"
          },
          "expectedFailure": {
            "code": "APPROVAL_TARGET_MISMATCH",
            "category": "approval",
            "retryable": false,
            "stage": "apply"
          }
        },
        {
          "id": "plan-hash-mismatch",
          "request": {
            "approvalPlanHash": "sha256:fixture-normal-sales-by-region-v1",
            "applyingPlanHash": "sha256:fixture-conflicting-plan-v1"
          },
          "expectedFailure": {
            "code": "APPROVAL_PLAN_HASH_MISMATCH",
            "category": "approval",
            "retryable": false,
            "stage": "apply"
          }
        }
      ],
      "expected": {
        "status": "failed",
        "adapterMutationInvoked": false,
        "cleanupRequired": false
      }
    },
    {
      "id": "partial-apply-cleanup",
      "description": "Attachment failure after object creation triggers scoped cleanup and an auditable outcome.",
      "targets": [
        "cloud-dev",
        "windows-dev"
